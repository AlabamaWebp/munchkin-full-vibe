{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/../tsconfig.spec.json"
      }
    ]
  },
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1",
    "^@munchkin-lan/contracts$": "<rootDir>/../../../packages/contracts/src/index.ts",
    "^@munchkin-lan/game-engine$": "<rootDir>/../../../packages/game-engine/src/index.ts"
  }
}
